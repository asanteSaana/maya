# Server-only. Never prefix these with NEXT_PUBLIC_ — they would be inlined
# into the browser bundle. All backend calls go through /api/maya/* instead.
MAYA_API_BASE_URL=https://ecommerce-backend-9tly.onrender.com
MAYA_API_KEY=

# Optional. Comma-separated role names allowed into /admin, matched
# case-insensitively. Leave unset to use the default list, which includes
# "Partner" because this backend ships only Customer and Partner and treats
# Partner as the elevated role.
#
# Set this once a dedicated admin role exists — for example
#   NEXT_PUBLIC_MAYA_ADMIN_ROLES=admin
# so that ordinary sellers no longer reach the console.
# NEXT_PUBLIC_MAYA_ADMIN_ROLES=

# Optional. Role id used when someone registers as a farmer. Self-registration
# currently always returns the Customer role, so seller accounts have to be
# provisioned on the backend until this is known.
# NEXT_PUBLIC_MAYA_ROLE_FARMER=
